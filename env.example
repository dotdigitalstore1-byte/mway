# Supabase PostgreSQL connection string (Transaction pooler, port 6543)
# Get it from: Supabase > Project Settings > Database > Connection string > Transaction pooler
# Format: postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.your-project-ref:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
